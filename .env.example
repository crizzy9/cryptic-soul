# Optional build-time overrides; the owner's Umami Cloud settings are in src/config.ts.
# For self-hosting, uncomment both and supply that instance's public tracking code.
# PUBLIC_UMAMI_WEBSITE_ID=<website UUID>
# PUBLIC_UMAMI_SCRIPT_URL=https://stats.example.com/script.js
# To disable analytics for a build explicitly:
# PUBLIC_UMAMI_WEBSITE_ID=
