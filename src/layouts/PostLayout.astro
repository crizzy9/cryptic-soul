---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import { getBadges, getBadgeClass, formatPublicationDate } from "../lib/helpers";

export interface Props extends BlogSchema {}

const { title, description, pubDate, updatedDate, heroImage, badges, tags = [], draft = false } = Astro.props;
const displayDate = formatPublicationDate(pubDate);
const displayBadges = getBadges(pubDate, badges);
import { Image } from "astro:assets";
---

<BaseLayout title={title} description={description} image={heroImage} ogType="article" noIndex={draft} sideBarActiveItemID="blog">
  <div class="md:flex md:justify-center">
    <article data-blog-article class="prose prose-lg min-w-0 max-w-[750px] prose-img:mx-auto">
      {draft && <div class="not-prose mb-6 rounded-lg border border-base-content/20 p-4"><strong>Draft for review.</strong> This post is available in local development and excluded from the production site.</div>}
      {heroImage && <Image width={750} height={422} format="webp" src={heroImage} alt={title} class="w-full mb-6" />}
      <h1 class="title my-2 text-4xl font-bold">{title}</h1>
      {pubDate && <time datetime={pubDate.toISOString()}>{displayDate}</time>}
      <br />
      {displayBadges.length > 0 && (
        <div class="flex flex-wrap gap-1 my-1">
          {displayBadges.map((badge) => (
            <div class={getBadgeClass(badge)}>{badge}</div>
          ))}
        </div>
      )}
      {
        tags &&
          tags.map((tag) => (
            <a href={`/blog/tag/${encodeURIComponent(tag)}`} class="badge badge-outline ml-2 no-underline">
              {tag}
            </a>
          ))
      }
      {
        updatedDate && (
          <div>
            {" "}
            Last updated on <time>{updatedDate}</time>{" "}
          </div>
        )
      }
      <div class="divider my-2"></div>
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  article {
    overflow-wrap: anywhere;
  }

  article :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
</style>
