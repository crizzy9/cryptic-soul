---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import { getBadges, getBadgeClass, formatPublicationDate } from "../lib/helpers";

export interface Props extends BlogSchema {}

const { title, description, pubDate, updatedDate, heroImage, heroImageAlt, heroImageCredit, heroImageSource, badges, tags = [], draft = false } = Astro.props;
const displayDate = formatPublicationDate(pubDate);
const displayBadges = getBadges(pubDate, badges);
import { Image } from "astro:assets";
---

<BaseLayout title={title} description={description} image={heroImage} ogType="article" noIndex={draft} sideBarActiveItemID="blog">
  <div class="md:flex md:justify-center">
    <article data-blog-article class="prose prose-lg min-w-0 max-w-[750px] prose-img:mx-auto">
      {heroImage && <figure class="not-prose mb-8 mt-0">
        <Image width={1200} height={675} format="webp" src={heroImage} alt={heroImageAlt || title} class="aspect-video w-full rounded-xl object-cover" />
        {heroImageCredit && <figcaption class="mt-2 text-sm text-base-content/70">Photo: {heroImageSource ? <a href={heroImageSource} class="link link-hover" target="_blank" rel="noopener noreferrer">{heroImageCredit}</a> : heroImageCredit}</figcaption>}
      </figure>}
      <h1 class="title my-3 text-3xl font-bold sm:text-4xl">{title}</h1>
      <div class="not-prose my-4 flex flex-wrap items-center gap-3 text-sm text-base-content/70">
        {pubDate && <time datetime={pubDate.toISOString()}>{displayDate}</time>}
        {draft && <span class="badge badge-outline">Draft for review</span>}
        {displayBadges.map((badge) => <span class={getBadgeClass(badge)}>{badge}</span>)}
      </div>
      <div class="not-prose my-4 flex flex-wrap gap-2">
        {tags.map((tag) => <a href={`/blog/tag/${encodeURIComponent(tag)}`} class="badge badge-outline no-underline">{tag}</a>)}
      </div>
      {
        updatedDate && (
          <div>
            {" "}
            Last updated on <time>{updatedDate}</time>{" "}
          </div>
        )
      }
      <div class="divider my-2"></div>
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  article {
    overflow-wrap: anywhere;
  }

  article :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
</style>
