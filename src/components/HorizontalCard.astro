---
import { Image } from "astro:assets";
import { getBadges, getBadgeClass, formatPublicationDate } from "../lib/helpers";

const { title, img, imgAlt = "", desc, url, badges, tags = [], pubDate, target = "_blank", tagLinks = false, id } = Astro.props;
const displayBadges = getBadges(pubDate, badges);
const displayDate = pubDate ? formatPublicationDate(pubDate) : undefined;
---

<article id={id} class="scroll-mt-20 rounded-lg bg-base-100">
  <div class="flex flex-col gap-4 p-4 md:flex-row md:gap-6">
    {img && (
      <Image src={img} width={750} height={422} format="webp" alt={imgAlt}
        class="aspect-video w-full rounded-lg object-cover md:max-h-36 md:w-52 md:shrink-0" />
    )}
    <div class="flex min-w-0 grow flex-col">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <h3 class="text-xl font-bold">
          {url ? (
            <a href={url} target={target} rel={target === "_blank" ? "noopener noreferrer" : undefined}
              class="link-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary">{title}</a>
          ) : title}
        </h3>
        <div class="flex flex-wrap gap-1">
          {displayBadges.map((badge) => <span class={getBadgeClass(badge)}>{badge}</span>)}
        </div>
      </div>
      <p class="py-2 leading-relaxed">{desc}</p>
      <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-2">
        {displayDate && <time datetime={new Date(pubDate).toISOString()} class="text-sm text-base-content/70">{displayDate}</time>}
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => tagLinks ? (
            <a href={`/blog/tag/${encodeURIComponent(tag)}`} class="badge badge-outline link-hover">{tag}</a>
          ) : <span class="badge badge-outline">{tag}</span>)}
        </div>
      </div>
    </div>
  </div>
</article>
