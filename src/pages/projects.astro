---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("project"))
  .sort((first, second) => Number(second.data.featured) - Number(first.data.featured)
    || second.data.pubDate.valueOf() - first.data.pubDate.valueOf());
const categories = [...new Set(projects.map((project) => project.data.category))];
---

<BaseLayout title="Projects · CrypticSoul" sideBarActiveItemID="projects">
  <h1 class="mb-3 text-3xl font-bold">Projects</h1>
  <p class="mb-10 max-w-prose leading-relaxed">Things I've built, projects I'm developing, and ideas I'm exploring. Avid, PupCam, Naavik, Lumino, and Plano are my current focus; earlier work spans robotics, machine learning, and developer tools.</p>
  {categories.map((category) => (
    <section class="mb-10" aria-label={`${category} projects`}>
      <h2 class="mb-4 text-2xl font-bold">{category}</h2>
      {projects.filter((project) => project.data.category === category).map((project) => (
        <>
          <HorizontalCard id={project.slug} title={project.data.title} img={project.data.heroImage}
            desc={project.data.description} url={project.data.githubUrl} target="_blank"
            badges={project.data.badges} pubDate={project.data.pubDate} tags={project.data.tags} />
          <div class="divider my-0" />
        </>
      ))}
    </section>
  ))}
</BaseLayout>
