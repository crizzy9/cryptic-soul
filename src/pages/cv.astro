---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import { getCollection } from "astro:content";
import { education, experience, skills } from "../data/profile";

const projects = (await getCollection("project", ({ data }) => data.featured))
  .sort((first, second) => second.data.pubDate.valueOf() - first.data.pubDate.valueOf());
---

<BaseLayout title="Résumé · Shyam Padia" description="Shyam Padia's experience in AI engineering, personalization, distributed systems, and self-hosted software." sideBarActiveItemID="cv">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-3xl font-bold">Résumé</h1>
    <a class="btn btn-primary" href="/Shyam-Padia-Resume.pdf" download>Download résumé (PDF)</a>
  </div>
  <p class="mb-4 max-w-prose text-lg leading-relaxed">AI Technical Lead at MosaicApp, building agent systems and the infrastructure around them. Previously a Senior Software Engineer at Intuit, working across personalization, recommendations, marketing automation, and pricing.</p>
  <p class="mb-10 max-w-prose leading-relaxed">My work connects AI and data engineering with product delivery: from Chello's agent architecture and model routing to platforms that turn large-scale data into useful customer experiences. Outside work, I build self-hosted software, developer tools, and robotics projects.</p>

  <section class="mb-10" aria-labelledby="experience-heading">
    <h2 id="experience-heading" class="mb-5 text-2xl font-bold">Experience</h2>
    <div class="time-line-container space-y-4">
      {experience.map((role) => (
        <TimeLineElement title={role.title} subtitle={role.subtitle}>
          <ul class="ml-5 list-disc space-y-2">
            {role.achievements.map((achievement) => <li>{achievement}</li>)}
          </ul>
        </TimeLineElement>
      ))}
    </div>
  </section>

  <section class="mb-10" aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="mb-5 text-2xl font-bold">Selected projects</h2>
    <ul class="space-y-5">
      {projects.map((project) => (
        <li>
          <h3 class="font-semibold"><a class="link link-hover" href={`/projects#${project.slug}`}>{project.data.title}</a></h3>
          <p class="mt-1 leading-relaxed">{project.data.description}</p>
        </li>
      ))}
    </ul>
    <a href="/projects" class="link mt-5 inline-block">Explore the full portfolio</a>
  </section>

  <section class="mb-10" aria-labelledby="education-heading">
    <h2 id="education-heading" class="mb-5 text-2xl font-bold">Education</h2>
    <div class="time-line-container space-y-4">
      {education.map((entry) => (
        <TimeLineElement title={entry.title} subtitle={entry.subtitle}>
          {entry.detail && <p>{entry.detail}</p>}
        </TimeLineElement>
      ))}
    </div>
  </section>

  <section class="mb-10" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="mb-5 text-2xl font-bold">Technical skills</h2>
    <dl class="space-y-4">
      {skills.map(([label, detail]) => (
        <div>
          <dt class="font-semibold">{label}</dt>
          <dd class="mt-1 leading-relaxed">{detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mb-10" aria-labelledby="open-source-heading">
    <h2 id="open-source-heading" class="mb-5 text-2xl font-bold">Open source contributions</h2>
    <ul class="ml-5 list-disc space-y-2">
      <li>Vicinae · Desktop application launcher · 2025</li>
      <li>Mopidy · Python music server · 2024</li>
    </ul>
  </section>
</BaseLayout>
